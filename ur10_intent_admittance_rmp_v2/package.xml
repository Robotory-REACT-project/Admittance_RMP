  <version>0.1.0</version>
  <description>Isolated experimental seventh admittance RMP for the guarded UR10 RMPflow controller.</description>
  <maintainer email="user@example.com">UR10 RMP team</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>ament_index_cpp</depend>
  <depend>rb10_rmpflow_rviz</depend>
  <depend>rcl_interfaces</depend>
  <depend>rclcpp</depend>
  <depend>realtime_tools</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>visualization_msgs</depend>
  <exec_depend>REACT_intrinsic</exec_depend>
  <exec_depend>Y2FT_AQ</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
