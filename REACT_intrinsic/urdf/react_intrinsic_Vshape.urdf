<?xml version="1.0" encoding="utf-8"?>
<robot name="react_intrinsic_Vshape">
  <link name="map"/>

  <link name="base_link">
    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="0 3.14159265359 0"/>
      <geometry>
        <mesh filename="package://REACT_intrinsic/meshes/vshape.STL" scale="1 1 1"/>
      </geometry>
      <material name="test_surface_gray">
        <color rgba="0.72 0.75 0.80 1.0"/>
      </material>
    </visual>
  </link>

  <joint name="map_to_base_link" type="fixed">
    <parent link="map"/>
    <child link="base_link"/>
  </joint>
</robot>
