<?xml version="1.0" encoding="utf-8"?>
<robot name="intrinsic_test_v4">
  <link name="map"/>

  <link name="base_link">
    <visual>
      <origin xyz="-0.11 0.064 -0.1" rpy="0 0 -1.57079632679"/>
      <geometry>
        <mesh filename="package://REACT_intrinsic/meshes/intrinsic_test_v4.STL" scale="1 1 1"/>
      </geometry>
      <material name="test_surface_gray">
        <color rgba="0.72 0.75 0.80 1.0"/>
      </material>
    </visual>
  </link>

  <joint name="map_to_base_link" type="fixed">
    <parent link="map"/>
    <child link="base_link"/>
  </joint>
</robot>
